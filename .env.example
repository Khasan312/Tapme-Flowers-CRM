# Docker Compose reads this file after it is copied to .env.
# Local development only; replace the example password in .env.
POSTGRES_DB=tapme_flowers
POSTGRES_USER=tapme
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=55432

# Redis is enabled with the jobs profile and is available on localhost only.
REDIS_PORT=6379

# Local Django configuration. Generate a secret before starting the API.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
API_PORT=8000
# Optional: password for bootstrap_business. Otherwise it prompts privately.
# TAPME_BOOTSTRAP_PASSWORD=

# Keep photos on the local filesystem / persistent Docker volume.
TAPME_PHOTO_STORAGE=filesystem
# fake: local simulation, no Meta requests. Set live only when a real channel is configured.
TAPME_META_MODE=fake
# Optional WhatsApp Cloud API. Keep values empty until Meta is configured.
# Set an API version supported by your Meta app, e.g. vXX.0.
META_GRAPH_VERSION=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Generate locally: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TAPME_SECRETS_KEY=
