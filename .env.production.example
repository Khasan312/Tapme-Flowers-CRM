PUBLIC_DOMAIN=flowers.example.com
POSTGRES_DB=tapme_flowers
POSTGRES_USER=tapme
POSTGRES_PASSWORD=replace-with-a-long-random-password
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
TAPME_BOOTSTRAP_PASSWORD=replace-with-a-long-random-owner-password
# Optional private S3-compatible photo storage:
# TAPME_PHOTO_STORAGE=s3
# AWS_STORAGE_BUCKET_NAME=tapme-private-photos
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_ENDPOINT_URL=https://...
# AWS_S3_REGION_NAME=...

# Keep photos on the local filesystem / persistent Docker volume.
TAPME_PHOTO_STORAGE=filesystem
