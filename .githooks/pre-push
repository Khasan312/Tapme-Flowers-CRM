#!/usr/bin/env bash
# Local protection against accidental direct pushes; GitHub rules are separate.
set -euo pipefail
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case $remote_ref in
        refs/heads/main|refs/heads/develop)
            echo "Direct push to ${remote_ref#refs/heads/} is blocked locally. Push a working branch and open a PR." >&2
            exit 1
            ;;
    esac
done
