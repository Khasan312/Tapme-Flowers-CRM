#!/usr/bin/env bash
# Local protection against accidental direct pushes; GitHub rules are separate.
set -euo pipefail
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [[ $remote_ref == refs/heads/main ]]; then
        echo 'Direct push to main is blocked locally. Push a branch and open a PR.' >&2
        exit 1
    fi
done
