{
    servers {
        max_header_size 32KB
    }
}

(application) {
    route {
        request_header X-Tapme-Client-IP {remote_host}
        import /etc/caddy/active.caddy
    }
}

{$PUBLIC_DOMAIN} {
    import application
}
www.{$PUBLIC_DOMAIN} {
    redir https://{$PUBLIC_DOMAIN}{uri} permanent
}
# This port is published exclusively on the server's loopback interface.
:8080 {
    import application
}
