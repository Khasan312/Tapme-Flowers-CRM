:80 {
    encode zstd gzip
    request_body {
        max_size 12MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        X-Robots-Tag "noindex, nofollow, noarchive"
        X-Flower-Environment staging
        X-Flower-Revision {$IMAGE_TAG}
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
    respond /robots.txt "User-agent: *\nDisallow: /\n" 200
    @api path /api/* /health/
    handle @api {
        reverse_proxy api:8000 {
            # This listener is reachable only through localhost or the HTTPS tunnel.
            header_up X-Forwarded-Proto https
            header_up Host {$PUBLIC_DOMAIN}
        }
    }
    handle_path /static/* {
        root * /srv/django-static
        file_server
    }
    handle_path /assets/* {
        root * /srv/shared-assets
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    @entry path / /crm-flowers
    handle @entry {
        route {
            rewrite * /crm-flowers/
            redir {uri} 308
        }
    }
    handle_path /crm-flowers/assets/* {
        root * /srv/shared-assets
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle_path /crm-flowers/* {
        root * /srv/frontend
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
    handle /track/* {
        root * /srv/frontend
        header Cache-Control "no-cache"
        rewrite * /index.html
        file_server
    }
    handle {
        respond "Not found" 404
    }
}
